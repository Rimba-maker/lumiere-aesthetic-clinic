}
.doctor-avatar--f1 { background: linear-gradient(145deg, #F5E6D8, #EBD4C0); color: #8B5E3C; }
.doctor-avatar--f2 { background: linear-gradient(145deg, #E8D5E8, #D8C0D8); color: #7B4A7B; }
.doctor-avatar--f3 { background: linear-gradient(145deg, #D8EAE8, #C0D8D5); color: #3B6B68; }
.doctor-avatar--m1 { background: linear-gradient(145deg, #D8E2F0, #C0CFE8); color: #3B5A8B; }
.doctor-avatar-initials {
  font-family: var(--font-serif);
  font-size: 48px;
  font-weight: 600;
  z-index: 1;
}
.doctor-avatar::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 30%, rgba(255,255,255,0.4) 0%, transparent 60%);
}
.doctor-body { padding: 22px; }
.doctor-name {
  font-family: var(--font-serif);
  font-size: 16px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4px;
  line-height: 1.3;
}
.doctor-specialty {
  font-size: 13px;
  color: var(--gold);
  font-weight: 500;
  margin-bottom: 8px;
}
.doctor-exp {
  font-size: 13px;
  color: var(--ink-soft);
  line-height: 1.5;
}

/* ── CLINIC GALLERY ──────────────────────────────────────────────── */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto;
  gap: 16px;
}
.gallery-item {
  border-radius: var(--r-card);
  overflow: hidden;
  position: relative;
  cursor: pointer;
  aspect-ratio: 4/3;
  transition: transform 0.3s ease;
}
.gallery-item:hover { transform: scale(1.02); }
.gallery-item:first-child {
  grid-column: span 2;
  aspect-ratio: 16/9;
}
.gallery-bg {
  width: 100%; height: 100%;
  position: absolute;
  inset: 0;
}
.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(15,9,7,0.6) 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  align-items: flex-end;
  padding: 20px;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-caption {
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  color: var(--on-dark);
}
/* Gallery gradient backgrounds */
.gallery-bg--1 { background: linear-gradient(145deg, #2A1F1A, #3D2D24, #4A3628); }
.gallery-bg--2 { background: linear-gradient(145deg, #1E2832, #283848, #2E4052); }
.gallery-bg--3 { background: linear-gradient(145deg, #2A2018, #3A2E22, #3E3028); }
.gallery-bg--4 { background: linear-gradient(145deg, #1A2520, #253530, #2A3D38); }
.gallery-bg--5 { background: linear-gradient(145deg, #28201C, #3C2C26, #462E28); }
.gallery-bg--6 { background: linear-gradient(145deg, #1E1A28, #2A2438, #30283E); }
.gallery-bg--icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(36px, 6vw, 64px);
  opacity: 0.25;
}

/* ── MEMBERSHIP ──────────────────────────────────────────────────── */
.membership-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  align-items: start;
}
.membership-card {
  background: var(--white);
  border: 1px solid rgba(15,9,7,0.08);
  border-radius: var(--r-card);
  padding: 36px 28px;
  box-shadow: var(--shadow-card);
  transition: all 0.3s ease;
}
.membership-card:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-4px);
}
.membership-card--vip {
  background: linear-gradient(#FFF8F0, #FFF8F0) padding-box,
    linear-gradient(135deg, #C5975A 0%, #F0D07A 50%, #C5975A 100%) border-box;
  border: 2px solid transparent;
  background-size: 100% 100%, 200% 200%;
  animation: gold-flow 4s linear infinite;
  padding: 40px 28px;
}
@keyframes gold-flow {
  from { background-position: 0 0, 0% 50%; }
  to   { background-position: 0 0, 200% 50%; }
}
.membership-emoji { font-size: 28px; margin-bottom: 16px; }
.membership-name {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6px;
}
.membership-price {
  font-size: 28px;
  font-weight: 700;
  font-family: var(--font-serif);
  color: var(--gold-deep);
  margin-bottom: 4px;
  letter-spacing: -0.02em;
}
.membership-period {
  font-size: 13px;
  color: var(--ink-soft);
  margin-bottom: 24px;
}
.membership-savings {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  color: var(--gold-deep);
  background: var(--gold-pale);
  border-radius: 20px;
  padding: 3px 10px;
  margin-bottom: 24px;
}
.membership-divider {
  height: 1px;
  background: rgba(15,9,7,0.08);
  margin-bottom: 24px;
}
.membership-list { margin-bottom: 32px; }
.membership-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  color: var(--ink-soft);
  line-height: 1.5;
  padding: 6px 0;
}
.membership-item::before {
  content: '✓';
  color: var(--gold);
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 1px;
}
.membership-cta { width: 100%; text-align: center; justify-content: center; }

/* ── TESTIMONIAL ─────────────────────────────────────────────────── */
.testimonial-track {
  position: relative;
  max-width: 760px;
  margin: 0 auto;
  min-height: 280px;
}
.testimonial-item {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: translateX(24px);
  transition: opacity 0.55s ease, transform 0.55s ease;
  pointer-events: none;
}
.testimonial-item.active {
  opacity: 1;
  transform: none;
  pointer-events: all;
  position: relative;
}
.testimonial-quote-mark {
  font-family: var(--font-serif);
  font-size: 80px;
  line-height: 0.6;
  color: var(--gold-on-dark);
  opacity: 0.4;
  margin-bottom: 16px;
  display: block;
}
.testimonial-text {
  font-family: var(--font-serif);
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 400;
  font-style: italic;
  line-height: 1.6;
  color: var(--on-dark);
  margin-bottom: 32px;
}
.testimonial-meta {
  display: flex;
  align-items: center;
  gap: 16px;
}
.testimonial-avatar {
  width: 48px; height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 18px;
  font-weight: 600;
  flex-shrink: 0;
}
.ta-1 { background: rgba(197,151,90,0.25); color: var(--gold-on-dark); }
.ta-2 { background: rgba(180,140,200,0.25); color: #C8A0E0; }
.ta-3 { background: rgba(140,180,160,0.25); color: #90C8B0; }
.ta-4 { background: rgba(160,180,220,0.25); color: #A0B4E0; }
.ta-5 { background: rgba(220,160,140,0.25); color: #E0A090; }
.testimonial-name {
  font-weight: 600;
  font-size: 15px;
  color: var(--on-dark);
  margin-bottom: 2px;
}
.testimonial-detail {
  font-size: 13px;
  color: var(--on-dark-soft);
}
.testimonial-stars {
  color: var(--gold-on-dark);
  font-size: 13px;
  letter-spacing: 1px;
}
.testimonial-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 48px;
}
.testimonial-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: rgba(247,243,238,0.25);
  border: none;
  cursor: pointer;
  transition: all 0.25s ease;
}
.testimonial-dot.active {
  background: var(--gold-on-dark);
  width: 24px;
  border-radius: 4px;
}

/* ── BOOKING ─────────────────────────────────────────────────────── */
.booking-inner {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: center;
}
.booking-info-list { margin-top: 32px; }
.booking-info-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(15,9,7,0.07);
}
.booking-info-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  background: var(--gold-pale);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.booking-info-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 2px;
}
.booking-info-text {
  font-size: 13px;
  color: var(--ink-soft);
  line-height: 1.5;
}
.booking-form {
  background: var(--white);
  border: 1px solid rgba(15,9,7,0.08);
  border-radius: 20px;
  padding: 44px;
  box-shadow: var(--shadow-card-hover);
}
.booking-form-title {
  font-family: var(--font-serif);
  font-size: 26px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6px;
}
.booking-form-sub {
  font-size: 14px;
  color: var(--ink-soft);
  margin-bottom: 32px;
  line-height: 1.5;
}
.form-group { margin-bottom: 20px; }
.form-label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-soft);
  margin-bottom: 7px;
  letter-spacing: 0.01em;
}
.form-input,
.form-select {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid rgba(15,9,7,0.15);
  border-radius: var(--r-sm);
  font-family: var(--font-sans);
  font-size: 15px;
  color: var(--ink);
  background: var(--canvas);
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
  appearance: none;
}
.form-input:focus,
.form-select:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(197,151,90,0.12);
}
.form-input::placeholder { color: var(--ink-faint); }
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.form-submit {
  width: 100%;
  justify-content: center;
  margin-top: 8px;
  font-size: 16px;
  padding: 16px;
}

/* ── FOOTER ──────────────────────────────────────────────────────── */
.footer { background: var(--dark); padding: 80px 0 40px; }
.footer-top {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr;
  gap: 56px;
  margin-bottom: 64px;
}
.footer-brand {}
.footer-logo {
  font-family: var(--font-serif);
  font-size: 26px;
  font-weight: 600;
  color: var(--on-dark);
  letter-spacing: -0.02em;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.footer-logo-dot { font-size: 10px; color: var(--gold-on-dark); }
.footer-tagline {
  font-family: var(--font-serif);
  font-size: 14px;
  font-style: italic;
  color: var(--on-dark-soft);
  margin-bottom: 24px;
}
.footer-socials { display: flex; gap: 12px; }
.footer-social {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(247,243,238,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--on-dark-soft);
  transition: all 0.2s ease;
}
.footer-social:hover {
  background: rgba(247,243,238,0.08);
  border-color: rgba(247,243,238,0.3);
  color: var(--on-dark);
}
.footer-col-title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold-on-dark);
  margin-bottom: 20px;
}
.footer-links { display: flex; flex-direction: column; gap: 12px; }
.footer-link {
  font-size: 14px;
  color: var(--on-dark-soft);
  line-height: 1.5;
  transition: color 0.2s;
}
.footer-link:hover { color: var(--on-dark); }
.footer-bottom {
  padding-top: 32px;
  border-top: 1px solid rgba(247,243,238,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}
.footer-legal {
  font-size: 12px;
  color: rgba(247,243,238,0.35);
}
.footer-certs { display: flex; gap: 12px; }
.footer-cert {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: rgba(247,243,238,0.4);
  border: 1px solid rgba(247,243,238,0.12);
  border-radius: 4px;
  padding: 4px 10px;
}

/* ── RESPONSIVE ──────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  :root { --gutter: 28px; }
  .treatments-grid  { grid-template-columns: repeat(2, 1fr); }
  .tech-grid        { grid-template-columns: repeat(3, 1fr); }
  .doctors-grid     { grid-template-columns: repeat(2, 1fr); }
  .footer-top       { grid-template-columns: 1fr 1fr; gap: 40px; }
  .booking-inner    { grid-template-columns: 1fr; gap: 48px; }
}
@media (max-width: 768px) {
  :root { --section-py: 64px; --gutter: 20px; }
  .nav-links, .nav-cta { display: none; }
  .nav-hamburger { display: flex; }
  .treatments-grid  { grid-template-columns: 1fr; }
  .tech-grid        { grid-template-columns: repeat(2, 1fr); }
  .category-grid    { grid-template-columns: 1fr; }
  .doctors-grid     { grid-template-columns: repeat(2, 1fr); }
  .membership-grid  { grid-template-columns: 1fr; }
  .gallery-grid     { grid-template-columns: repeat(2, 1fr); }
  .gallery-item:first-child { grid-column: span 2; }
  .footer-top       { grid-template-columns: 1fr; gap: 32px; }
  .form-row         { grid-template-columns: 1fr; }
  .trust-badges     { gap: 0; }
  .trust-badge      { padding: 0 20px; }
  .hero-ctas        { flex-direction: column; align-items: center; }
  .hero-ctas .btn   { width: 100%; max-width: 320px; justify-content: center; }
}
@media (max-width: 480px) {
  .tech-grid     { grid-template-columns: 1fr; }
  .doctors-grid  { grid-template-columns: 1fr; }
  .gallery-grid  { grid-template-columns: 1fr; }
  .gallery-item:first-child { grid-column: span 1; aspect-ratio: 4/3; }
  .trust-badge   { padding: 0 12px; }
  .booking-form  { padding: 28px 20px; }
}

/* mobile nav open state */
.nav-links.open {
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 68px; left: 0; right: 0;
  background: rgba(247,243,238,0.97);
  backdrop-filter: blur(20px);
  padding: 24px var(--gutter) 32px;
  gap: 20px;
  box-shadow: var(--shadow-nav);
  z-index: 999;
}
.nav-cta.open {
  display: flex;
  position: fixed;
  bottom: 24px;
  left: var(--gutter); right: var(--gutter);
  justify-content: center;
  z-index: 999;
}

