---
import { faq } from '../data/clinic';
---
<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="faq-h">Pertanyaan tentang treatment</h2>
      <p class="ph-hide">Jawaban singkat sebelum Anda berkonsultasi dengan dokter.</p>
    </div>
    <div class="faq">
      {faq.map((f, i) => (
        <div class={`faq__item${i > 2 ? ' ph-hide' : ''}`}><h3>{f.q}</h3><p>{f.a}</p></div>
      ))}
    </div>
  </div>
</section>
