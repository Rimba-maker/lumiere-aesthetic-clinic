---
import { faq } from '../data/clinic';
---
<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="grid grid--top">
      <div class="span-6">
        <div class="section-head">
          <h2 id="faq-h">Pertanyaan tentang treatment</h2>
          <p>Jawaban singkat sebelum Anda konsultasi dengan dokter.</p>
        </div>
      </div>
      <div class="faq span-6 start-7">
        {faq.map((f) => (
          <div class="faq__item"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </div>
  </div>
</section>
