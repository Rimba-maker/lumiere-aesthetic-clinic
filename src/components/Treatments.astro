---
import { treatments, photo } from '../data/clinic';
---
<section class="section" id="treatment" style="--hm: 2" aria-labelledby="treatment-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="treatment-h">6 signature treatment, mulai Rp 850 rb</h2>
      <p class="nt-hide">Kombinasi teknologi dan keahlian dokter untuk hasil yang bertahan.</p>
    </div>
    <div class="grid grid--top fill" data-peek>
      <ul class="rows span-6">
        {treatments.map((t) => (
          <li data-peek-to={t.key} tabindex="0">
            <span class="rows__name">{t.name}</span>
            <p>{t.line}</p>
            <span class="rows__value">{t.price}</span>
          </li>
        ))}
      </ul>
      <div class="frame frame--photo frame--fill span-6 start-7">
        {treatments.map((t, i) => (
          <img class="frame__img" data-peek-for={t.key} src={photo(t.img)} alt={t.alt} width="1200" height="1500" hidden={i > 0} data-source="library-pexels" data-subject={t.name} />
        ))}
      </div>
    </div>
  </div>
</section>
