---
import { brand } from '../data/clinic';
interface Props { inner?: boolean }
const { inner = false } = Astro.props;
const p = inner ? '/' : '';
---
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip" href="#top">Lewati ke konten</a>
    <a class="nav__logo" href={`${p}#top`}>{brand.name}</a>
    <nav class="nav__links" aria-label="Utama">
      <div class="nav__item">
        <a class="nav__link" href={`${p}#treatment`}>Treatment <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-4">
              <p class="t-label">Signature treatment</p>
              <a href={`${p}#treatment`}>Lumière Glow Facial<span>Facial dengan LED therapy</span></a>
              <a href={`${p}#treatment`}>HydraFacial MD<span>Cleansing dan serum infusion</span></a>
              <a href={`${p}#treatment`}>Pico Laser<span>Flek, scar dan rejuvenasi</span></a>
            </div>
            <div class="menu-col span-4">
              <p class="t-label">Berdasarkan concern</p>
              <a href={`${p}#concern`}>Wajah dan tubuh<span>Acne, anti-aging, slimming</span></a>
              <a href={`${p}#concern`}>Laser dan injectable<span>Hair removal, botox, filler</span></a>
              <a href={`${p}#concern`}>Skincare dan pria<span>Konsultasi produk personal</span></a>
            </div>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href={`${p}#teknologi`}>Teknologi</a></div>
      <div class="nav__item"><a class="nav__link" href={`${p}#dokter`}>Dokter</a></div>
      <div class="nav__item"><a class="nav__link" href={`${p}#klinik`}>Klinik</a></div>
      <div class="nav__item"><a class="nav__link" href={`${p}#membership`}>Membership</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={`${p}#booking`}>{brand.mainAction}</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
