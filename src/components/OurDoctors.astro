---
const doctors = [
  {
    initials: 'AR',
    avatarClass: 'doctor-avatar--f1',
    photo: 'https://images.pexels.com/photos/8376309/pexels-photo-8376309.jpeg?auto=compress&cs=tinysrgb&w=400',
    name: 'Dr. Anisa Rahmawati, Sp.KK',
    specialty: 'Dermatologist',
    exp: '12+ tahun pengalaman. Spesialis laser dan pigmentation. Lulusan FKUI, tersertifikasi AAAM.',
  },
  {
    initials: 'KH',
    avatarClass: 'doctor-avatar--m1',
    photo: null,
    name: 'Dr. Kevin Hartono, M.Biomed',
    specialty: 'Aesthetic Medicine',
    exp: 'Ahli injectable dan facial contouring. Tersertifikasi AAM, alumni Universitas Indonesia.',
  },
  {
    initials: 'LW',
    avatarClass: 'doctor-avatar--f2',
    photo: 'https://images.pexels.com/photos/3714743/pexels-photo-3714743.jpeg?auto=compress&cs=tinysrgb&w=400',
    name: 'Dr. Linda Wijaya, Sp.KK',
    specialty: 'Laser Specialist',
    exp: 'Sertifikasi internasional ISDS. Spesialis laser advanced dan treatment kulit sensitif.',
  },
  {
    initials: 'RP',
    avatarClass: 'doctor-avatar--f3',
    photo: null,
    name: 'Dr. Raka Pratama',
    specialty: 'Body Treatment Lead',
    exp: 'Spesialis body contouring dan slimming treatment. Berpengalaman di 5 klinik estetika premium.',
  },
];
---
<section class="section section--ceramic" id="doctors">
  <div class="container">
    <div class="section-header section-header--center">
      <p class="label-tag" data-reveal>Tim Medis Kami</p>
      <h2 class="section-heading" data-reveal data-delay="1">Ditangani Oleh Yang Terbaik</h2>
      <p class="section-sub" data-reveal data-delay="2">
        Setiap dokter kami memiliki sertifikasi internasional dan pengalaman bertahun-tahun di bidang estetika medis.
      </p>
    </div>
    <div class="doctors-grid">
      {doctors.map((d, i) => (
        <div class="doctor-card" data-reveal data-delay={String(i + 1)}>
          <div class={`doctor-avatar ${d.avatarClass}`}>
            {d.photo
              ? <img src={d.photo} alt={d.name} class="doctor-photo" loading="lazy" />
              : <span class="doctor-initials">{d.initials}</span>
            }
          </div>
          <div class="doctor-body">
            <div class="doctor-name">{d.name}</div>
            <div class="doctor-specialty">{d.specialty}</div>
            <div class="doctor-exp">{d.exp}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
