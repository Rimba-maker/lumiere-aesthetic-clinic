---
import { concerns } from '../data/clinic';
import Img from './Img.astro';
---
<section class="section" id="concern" aria-labelledby="concern-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="concern-h">Solusi untuk 6 concern kulit</h2>
    </div>
    <div class="grid">
      {concerns.map((c) => (
        <a class={`tile span-4 focus-${c.img}`} href="#booking">
          <div class="tile__media"><Img name={c.img} alt={c.alt} w={1000} h={667} subject={c.name} /></div>
          <div class="tile__head"><h3>{c.name}</h3></div>
          <p class="ph-hide nt-hide">{c.line}</p>
        </a>
      ))}
    </div>
  </div>
</section>
