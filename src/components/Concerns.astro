---
import { concerns, photo } from '../data/clinic';
---
<section class="section" id="concern" aria-labelledby="concern-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="concern-h">Solusi untuk 6 concern kulit</h2>
    </div>
    <div class="grid">
      {concerns.map((c) => (
        <a class="tile span-4" href="#booking">
          <div class="tile__media"><img src={photo(c.img)} alt={c.alt} width="1000" height="667" loading="lazy" decoding="async" style={`object-position:${c.pos}`} data-source="library-pexels" data-subject={c.name} /></div>
          <div class="tile__head"><h3>{c.name}</h3></div>
          <p class="ph-hide">{c.line}</p>
        </a>
      ))}
    </div>
  </div>
</section>
