---
import { doctors } from '../data/clinic';
import Img from './Img.astro';
---
<section class="section" id="dokter" aria-labelledby="dokter-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="dokter-h">4 dokter yang menangani Anda</h2>
      <p class="ph-hide nt-hide">Dermatolog, dokter estetika, spesialis laser, dan dokter umum untuk perawatan tubuh.</p>
    </div>
    <div class="grid">
      {doctors.map((d) => (
        <article class={`tile tile--portrait span-3 focus-${d.img}`}>
          <div class="tile__media"><Img name={d.img} alt={d.alt} w={900} h={1125} subject="doctor portrait" full={d.img === 'dr-kevin' || d.img === 'dr-linda'} /></div>
          <div class="tile__head"><h3>{d.name}</h3></div>
          <p class="tile__facts">{d.role}</p>
          <p class="ph-hide nt-hide">{d.line}</p>
        </article>
      ))}
    </div>
  </div>
</section>
