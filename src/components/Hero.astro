---
import { brand } from '../data/clinic';
import Img from './Img.astro';
---
<section class="hero hero--split" aria-labelledby="hero-h">
  <div class="wrap">
    <div class="hero-text grid hero-split">
      <div class="hero-copy span-6">
        <p class="hero-notice">5 cabang di Jakarta, Surabaya dan Bandung</p>
        <h1 id="hero-h">Klinik estetika dokter spesialis di Jakarta</h1>
        <p class="t-lead">Treatment kulit dengan teknologi FDA-approved oleh dokter spesialis. Konsultasi pertama gratis.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#booking">{brand.mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
          <a class="btn btn--secondary" href="#treatment">Lihat treatment</a>
        </div>
        <dl class="hero-facts">
          <div><dt>Treatment</dt><dd>10.000+</dd></div>
          <div><dt>Dokter</dt><dd>4 dokter</dd></div>
          <div><dt>Cabang</dt><dd>5 cabang</dd></div>
        </dl>
      </div>
      <div class="hero-visual frame frame--photo span-6 start-7">
        <Img class="frame__img" name="hero-facial" w={1600} h={2400} alt="Klien menjalani facial dengan perangkat klinis di Lumière" pos="50% 40%" subject="facial treatment" priority />
      </div>
    </div>
  </div>
</section>
