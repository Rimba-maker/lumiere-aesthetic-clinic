---
---
<section class="hero" id="hero">
  <div class="hero-bg">
    <img
      src="https://images.unsplash.com/photo-1581182815808-b6eb627a8798?w=1920&q=80&auto=format&fit=crop"
      alt=""
      class="hero-photo"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="hero-photo-overlay"></div>
    <div class="hero-orb hero-orb--1"></div>
    <div class="hero-orb hero-orb--2"></div>
    <div class="hero-orb hero-orb--3"></div>
  </div>
  <div class="hero-inner container">
    <p class="hero-tag" data-reveal>✦ &nbsp; Klinik Kecantikan &amp; Estetika Premium &nbsp; ✦</p>
    <h1 class="hero-headline" data-reveal data-delay="1">
      Kulit Sehat Yang<br />Bercahaya, Tanpa Filter.
    </h1>
    <p class="hero-tagline" data-reveal data-delay="2">Glow From Within, Powered By Science.</p>
    <p class="hero-sub" data-reveal data-delay="3">
      Klinik kecantikan dengan teknologi FDA-approved, ditangani dokter spesialis.
      Solusi personal untuk setiap concern kulit Anda.
    </p>
    <div class="hero-ctas" data-reveal data-delay="4">
      <a href="#booking" class="btn btn-gold btn-lg">Book Konsultasi Gratis</a>
      <a href="#treatments" class="btn btn-ghost btn-lg">Lihat Treatment</a>
    </div>
    <div class="trust-badges" data-reveal data-delay="5">
      <div class="trust-badge">
        <span class="trust-num">10.000+</span>
        <span class="trust-label">Treatment</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <span class="trust-num">4</span>
        <span class="trust-label">Dokter Spesialis</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <span class="trust-num">FDA</span>
        <span class="trust-label">Approved Tech</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <span class="trust-num">ISO</span>
        <span class="trust-label">Certified Clinic</span>
      </div>
    </div>
  </div>
</section>
