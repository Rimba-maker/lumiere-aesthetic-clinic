---
import { brand, photo } from '../data/clinic';
---
<section class="section" id="booking" style="--hm: 2" aria-labelledby="booking-h">
  <div class="wrap">
    <div class="grid grid--top fill">
      <div class="span-6 stack-4">
        <div class="section-head">
          <h2 id="booking-h">Jadwalkan konsultasi pertama Anda</h2>
          <p class="nt-hide">Konsultasi pertama gratis. Tim kami menghubungi Anda lewat WhatsApp untuk konfirmasi jadwal.</p>
        </div>
        <div class="frame frame--photo booking__photo">
          <img class="frame__img" src={photo('booking-consult')} width="1200" height="800" loading="lazy" decoding="async" alt="Dokter berkonsultasi dengan pasien di ruang praktik" style="object-position: 50% 35%" data-source="library-pexels" data-subject="doctor consultation" />
        </div>
      </div>
      <form class="span-6 start-7 form ground-surface" method="post" action="mailto:booking@lumiere.example" enctype="text/plain" style="padding: var(--s-7); border-radius: var(--r-lg)">
        <label class="field field--full">Nama lengkap<input type="text" name="nama" autocomplete="name" required></label>
        <label class="field">Nomor WhatsApp<input type="tel" name="whatsapp" autocomplete="tel" inputmode="tel" required></label>
        <label class="field">Tanggal booking<input type="text" name="tanggal" placeholder="Contoh: 12 Desember" required></label>
        <label class="field">Concern kulit
          <select name="concern" required>
            <option value="">Pilih concern</option>
            <option>Wajah</option><option>Tubuh</option><option>Laser</option><option>Injectable</option><option>Skincare</option><option>Pria</option>
          </select>
        </label>
        <label class="field">Cabang
          <select name="cabang" required>
            <option value="">Pilih cabang</option>
            <option>Jakarta, PIK</option><option>Jakarta, Kemang</option><option>Jakarta, Senopati</option><option>Surabaya</option><option>Bandung</option>
          </select>
        </label>
        <div class="btn-row"><button class="btn btn--primary" type="submit">{brand.mainAction}</button></div>
        <p class="t-small muted">Kami membalas lewat WhatsApp pada hari kerja.</p>
      </form>
    </div>
  </div>
</section>
