---
import { devices } from '../data/clinic';
import Img from './Img.astro';
---
<section class="section" id="teknologi" aria-labelledby="teknologi-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="teknologi-h">Teknologi klinis teruji, disetujui FDA/CE</h2>
    </div>
    <div class="grid grid--top fill">
      <ul class="rows rows--spec span-6">
        {devices.map((d, i) => (
          <li class={i > 2 ? 'ph-hide' : undefined}><span class="rows__name">{d.name}</span><p>{d.line}</p></li>
        ))}
      </ul>
      <div class="frame frame--photo frame--fill span-6 start-7">
        <Img class="frame__img" name="tech-device" w={1400} h={933} alt="Dokter menjalankan treatment wajah dengan perangkat klinis" pos="50% 55%" subject="aesthetic device" sizes="(max-width: 1023px) 100vw, 80vw" />
      </div>
    </div>
  </div>
</section>
