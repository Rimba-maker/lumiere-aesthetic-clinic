---
import { devices, photo } from '../data/clinic';
---
<section class="section" id="teknologi" aria-labelledby="teknologi-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="teknologi-h">Teknologi klinis teruji, disetujui FDA/CE</h2>
    </div>
    <div class="grid grid--top fill">
      <ul class="rows rows--spec span-6">
        {devices.map((d) => (
          <li><span class="rows__name">{d.name}</span><p>{d.line}</p></li>
        ))}
      </ul>
      <div class="frame frame--photo frame--fill span-6 start-7">
        <img class="frame__img" src={photo('tech-device')} width="1400" height="933" loading="lazy" decoding="async" alt="Dokter menjalankan treatment wajah dengan perangkat klinis" style="object-position: 50% 55%" data-source="library-pexels" data-subject="aesthetic device" />
      </div>
    </div>
  </div>
</section>
