---
const photos = [
  {
    src: 'https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=1200&q=80&auto=format&fit=crop',
    caption: 'Grand Lobby — PIK Jakarta',
    span: true,
  },
  {
    src: 'https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=800&q=80&auto=format&fit=crop',
    caption: 'Treatment Room',
    span: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80&auto=format&fit=crop',
    caption: 'Recovery Lounge',
    span: false,
  },
  {
    src: 'https://images.pexels.com/photos/3757952/pexels-photo-3757952.jpeg?auto=compress&cs=tinysrgb&w=800',
    caption: 'Consultation Room',
    span: false,
  },
  {
    src: 'https://images.pexels.com/photos/3997993/pexels-photo-3997993.jpeg?auto=compress&cs=tinysrgb&w=800',
    caption: 'VIP Treatment Suite',
    span: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=800&q=80&auto=format&fit=crop',
    caption: 'Skincare Boutique',
    span: false,
  },
];
---
<section class="section section--dark3" id="gallery">
  <div class="container">
    <div class="section-header">
      <p class="label-tag" data-reveal>Lihat Klinik Kami</p>
      <h2 class="section-heading section-heading--light" data-reveal data-delay="1">
        Ruang Yang Membuat<br />Anda Nyaman
      </h2>
      <p class="section-sub section-sub--light" data-reveal data-delay="2">
        Setiap sudut klinik kami didesain untuk memberi pengalaman seperti spa premium — bukan rumah sakit kaku.
      </p>
    </div>
    <div class="gallery-grid">
      {photos.map((p, i) => (
        <div class={`gallery-item${p.span ? ' gallery-item--wide' : ''}`} data-reveal data-delay={String(i)}>
          <img src={p.src} alt={p.caption} class="gallery-photo" loading="lazy" />
          <div class="gallery-overlay">
            <span class="gallery-caption">{p.caption}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-item--wide { grid-column: span 2; aspect-ratio: 16/9; }
  .gallery-photo {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery-item:hover .gallery-photo { transform: scale(1.04); }
</style>
