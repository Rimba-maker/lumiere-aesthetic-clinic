---
import { steps, photo } from '../data/clinic';
---
<section class="section" id="proses" aria-labelledby="proses-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="proses-h">Dari konsultasi sampai kontrol dalam 3 langkah</h2>
    </div>
    <div class="grid">
      {steps.map((s) => (
        <article class="card card--row span-4">
          <span class="step-num" aria-hidden="true">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.line}</p>
          <div class="panel panel--flush">
            <img class="frame__img" src={photo(s.img)} alt={s.alt} width="1000" height="667" loading="lazy" decoding="async" style={`object-position:${s.pos}`} data-source="library-pexels" data-subject={s.title} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
