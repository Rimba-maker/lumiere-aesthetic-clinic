---
import { steps, photo } from '../data/clinic';
---
<section class="section" id="proses" aria-labelledby="proses-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="proses-h">Dari konsultasi sampai kontrol dalam 3 langkah</h2>
    </div>
    <div class="grid">
      {steps.map((s) => (
        <article class="tile span-4">
          <div class="tile__media"><img src={photo(s.img)} alt={s.alt} width="1000" height="667" loading="lazy" decoding="async" style={`object-position:${s.pos}`} data-source="library-pexels" data-subject={s.title} /></div>
          <p class="tile__facts">Langkah {s.n}</p>
          <div class="tile__head"><h3>{s.title}</h3></div>
          <p class="ph-hide">{s.line}</p>
        </article>
      ))}
    </div>
  </div>
</section>
