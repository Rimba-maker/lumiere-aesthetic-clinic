---
import { plans, photo } from '../data/clinic';
---
<section class="section" id="membership" style="--hm: 2" aria-labelledby="membership-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="membership-h">Paket dan membership</h2>
    </div>
    <div class="grid">
      {plans.map((p) => (
        <article class="tile span-4">
          <div class="tile__media"><img src={photo(p.img)} alt={p.alt} width="900" height="600" loading="lazy" decoding="async" style={`object-position:${p.pos}`} data-source="library-pexels" data-subject={p.name} /></div>
          <div class="tile__head"><h3>{p.name}</h3>{p.saving && <span class="badge">{p.saving}</span>}</div>
          <p class="price"><span class="t-stat">{p.price}</span><span class="muted">{p.per}</span></p>
          <ul class="checks">
            {p.items.map((i) => <li>{i}</li>)}
          </ul>
          <a class="btn btn--secondary" href="#booking">Book paket</a>
        </article>
      ))}
    </div>
  </div>
</section>
