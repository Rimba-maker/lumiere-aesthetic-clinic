---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Lumière Aesthetic Clinic — Klinik Kecantikan & Estetika Premium",
  description = "Klinik kecantikan & estetika dengan teknologi FDA-approved. HydraFacial, Pico Laser, Botox, dan signature treatment lainnya. Konsultasi gratis.",
} = Astro.props;
---
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <slot />

  <script>
    // Scroll reveal
    const revealObs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          revealObs.unobserve(e.target);
        }
      }),
      { threshold: 0.12, rootMargin: '0px 0px -48px 0px' }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => revealObs.observe(el));
  </script>
</body>
</html>
