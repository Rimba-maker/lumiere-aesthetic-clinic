---
import { brand } from '../data/clinic';

interface Props {
  title?: string;
  description?: string;
  inner?: boolean; // privacy / terms / credits pages
}
const {
  title = 'Lumière Aesthetic Clinic: klinik estetika dokter spesialis di Jakarta',
  description = 'Klinik kecantikan dan estetika dengan teknologi FDA-approved: HydraFacial, Pico Laser, Botox dan signature treatment lain. Konsultasi pertama gratis.',
  inner = false,
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalClinic',
      name: brand.fullName,
      description,
      medicalSpecialty: ['Dermatology', 'PlasticSurgery'],
      areaServed: ['Jakarta', 'Surabaya', 'Bandung'],
    },
    { '@type': 'Physician', name: 'Dr. Anisa Rahmawati, Sp.KK', medicalSpecialty: 'Dermatology', worksFor: { '@type': 'MedicalClinic', name: brand.fullName } },
    { '@type': 'Physician', name: 'Dr. Kevin Hartono, M.Biomed (AAM)', medicalSpecialty: 'Aesthetic medicine', worksFor: { '@type': 'MedicalClinic', name: brand.fullName } },
    { '@type': 'Physician', name: 'Dr. Linda Wijaya, Sp.KK', medicalSpecialty: 'Dermatology', worksFor: { '@type': 'MedicalClinic', name: brand.fullName } },
    { '@type': 'Physician', name: 'Dr. Raka Pratama', medicalSpecialty: 'General practice', worksFor: { '@type': 'MedicalClinic', name: brand.fullName } },
  ],
};
---
<!doctype html>
<html lang="id" data-type="service" data-radius="soft" data-buttons="block" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="keywords" content="klinik kecantikan jakarta, aesthetic clinic, hydrafacial, pico laser, botox jakarta, skin booster">
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400..700&family=Libre+Franklin:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<!-- keep this <style> after the links: layout.css resets --ly-scale. Palette: start.mjs brand (own colours) -->
<style is:global>
:root {
  --p-bg: #fbf8f4; --p-surface: #f1e9e0; --p-ink: #2a1f19; --p-muted: #6b5b50;
  --p-accent: #8a5a2b; --p-accent-ink: #fbf8f4; --p-action: #8a5a2b; --p-action-ink: #fbf8f4;
  --p-inv-bg: #2a1f19; --p-inv-surface: #362c26; --p-inv-ink: #fbf8f4; --p-inv-muted: #a59e99;
  --p-inv-accent: #fbf8f4; --p-inv-accent-ink: #2a1f19; --p-inv-action: #fbf8f4; --p-inv-action-ink: #2a1f19;
  --font-display: "Source Serif 4", Georgia, serif;
  --font-text: "Libre Franklin", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.02em;
  --display-tracking-xl: -0.026em;
}
</style>
<script src="/assets/backgrounds/backgrounds.js" is:inline></script>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<style is:global>
  /* page CSS: only what sits inside a visual and the kit lacks */
  .wall { display: grid; gap: 2px; }
  .wall__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; }
  .wall a { position: relative; display: block; overflow: clip; height: 240px; background: var(--surface); }
  .wall img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .wall a:hover img { transform: scale(1.03); }
  @media (max-width: 1279px) { .wall a { height: 200px; } }
  @media (max-width: 639px) { .wall a { height: 150px; } }
  .tile .btn { justify-self: start; }
  /* tile ratios per section, the kit's own variable */
  #concern { --tile-ratio: 2 / 1; }
  .focus-dr-anisa img { object-position: 50% 25%; } .focus-dr-kevin img { object-position: 50% 20%; }
  .focus-dr-linda img { object-position: 84% 30%; } .focus-dr-raka img { object-position: 50% 20%; }
  .booking__photo { --ratio: 56%; }
  /* tablet and phone: the screens the checker counts */
  @media (min-width: 640px) and (max-width: 1023px) {
    #proses, #dokter, #membership { --h: 2; }
    #klinik .wall a { height: 240px; }
    .nt-hide { display: none; }
    .booking__photo { --ratio: 40%; }
  }
  @media (max-width: 1023px) { .faq__item.nt-hide { display: none; } }
  @media (max-width: 639px) {
    .ph-hide { display: none; }
    #concern { --tile-ratio: 4 / 3; }
    #dokter .tile--portrait { --tile-ratio: 1 / 1; }
    #teknologi .frame { --ratio: 38%; }
    #treatment [data-peek] .frame { --ratio: 150%; }
    #membership .grid > .tile { grid-column: 1 / -1; }
    #membership { --tile-ratio: 5 / 2; }
    .booking__photo { --ratio: 125%; }
  }
  .panel > img.frame__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .skip { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip:focus { width: auto; height: auto; clip-path: none; padding: var(--s-2) var(--s-3); background: var(--bg); z-index: 20; }
  .legal-page { padding: calc(var(--nav) + var(--s-9)) 0 var(--s-9); }
  .legal-page .wrap { max-width: 760px; display: grid; gap: var(--s-5); }
</style>
</head>
<body>
<!-- type: service (clinic). Kind line: people are hired -> service, site-kind other, no effects.
     deal: hero split, nav-mega, footer-columns (footer-visit dealt, re-dealt: no opening hours in the brief),
     close-type, rhythm space, buttons block, mark wordmark, grounds none (flat colour + photographs).
     Palette: brand colours (ivory, warm ink, bronze-gold) via start.mjs brand; type: source-serif (Source Serif 4 / Libre Franklin), radius soft.
     moments: none. Main action everywhere: "Book konsultasi gratis". -->
<slot />
<script type="module" src="/assets/system.js"></script>
<script type="module" src="/assets/motion/motion.js"></script>
<script type="module" src="/assets/layout/layout.js"></script>
</body>
</html>
