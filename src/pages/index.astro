---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SignatureTreatments from '../components/SignatureTreatments.astro';
import TreatmentCategories from '../components/TreatmentCategories';
import Technology from '../components/Technology.astro';
import BeforeAfter from '../components/BeforeAfter';
import OurDoctors from '../components/OurDoctors.astro';
import ClinicGallery from '../components/ClinicGallery.astro';
import Membership from '../components/Membership.astro';
import Testimonial from '../components/Testimonial';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Navbar />
  <main>
    <Hero />
    <SignatureTreatments />
    <TreatmentCategories client:visible />
    <Technology />
    <BeforeAfter client:visible />
    <OurDoctors />
    <ClinicGallery />
    <Membership />
    <Testimonial client:visible />
    <Booking />
  </main>
  <Footer />
</BaseLayout>
