---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Treatments from '../components/Treatments.astro';
import Concerns from '../components/Concerns.astro';
import Technology from '../components/Technology.astro';
import Process from '../components/Process.astro';
import Doctors from '../components/Doctors.astro';
import ClinicTour from '../components/ClinicTour.astro';
import Membership from '../components/Membership.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/clinic';
---

<BaseLayout>
  <Navbar />
  <main id="top">
    <Hero />
    <Treatments />
    <Concerns />
    <Technology />
    <Process />
    <Doctors />
    <ClinicTour />
    <Membership />
    <Faq />
    <Booking />
  </main>
  <Footer />
  <nav class="actionbar" aria-label="Aksi cepat">
    <a class="btn btn--primary" href="#booking">{brand.mainAction}</a>
  </nav>
</BaseLayout>
